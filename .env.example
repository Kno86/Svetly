# Copy to `.env` only if you need to override defaults. The local stack runs without this file.
# Never commit real values: `.env` and `.env.*` are git-ignored (except this example).

# --- Local (docker compose up -d --build) ---
# Host port for the web application (http://localhost:3000).
WEB_PORT=3000
# local | production. Production refuses database credentials containing "local_dev_only".
SVETLY_ENV=local
LOG_LEVEL=info
POSTGRES_USER=svetly
POSTGRES_DB=svetly
# Local development value only. Use a long random URL-safe value in production.
POSTGRES_PASSWORD=svetly_local_dev_only

# Optional build metadata shown by /api/version and /healthz.
GIT_SHA=
BUILD_TIME=

# --- Production overlay only (compose.prod.yaml) ---
SVETLY_DOMAIN=
ACME_EMAIL=
