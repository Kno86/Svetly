# Copy to `.env` only if you need to override defaults. The local stack runs without this file.
# Never commit real values: `.env` and `.env.*` are git-ignored (except this example).

# --- Local (docker compose up -d --build) ---
# Host port for the web application (http://localhost:3000).
WEB_PORT=3000
# local | production. Production refuses database credentials containing "local_dev_only".
SVETLY_ENV=local
LOG_LEVEL=info
POSTGRES_USER=svetly
POSTGRES_DB=svetly
# Local development value only. Use a long random URL-safe value in production.
POSTGRES_PASSWORD=svetly_local_dev_only

# Public URL of the web app (links in emails, cookie scope, CSRF origin check).
SVETLY_PUBLIC_URL=http://localhost:3000
# Leave empty locally: a random secret is generated once into the api-secrets volume.
BETTER_AUTH_SECRET=
# Local default: smtp://mailpit:1025 (UI: http://127.0.0.1:8025). Set to empty to test "email not configured".
# SMTP_URL=smtp://mailpit:1025
MAIL_FROM=SVETLY <no-reply@svetly.local>
MAILPIT_UI_PORT=8025

# Optional build metadata shown by /api/version and /healthz.
GIT_SHA=
BUILD_TIME=

# --- Production overlay only (compose.prod.yaml) ---
SVETLY_DOMAIN=
ACME_EMAIL=
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
# BETTER_AUTH_SECRET=
# Required in production: real SMTP provider, e.g. smtps://user:password@smtp.example.com:465
# SMTP_URL=
# MAIL_FROM=SVETLY <no-reply@your-domain>
