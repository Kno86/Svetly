generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level key/value configuration. Values are non-secret; secrets live only in the environment.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Authentication (managed by Better Auth; field names follow its schema)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// Set by staff; a blocked user cannot sign in and all sessions are revoked.
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions   Session[]
  accounts   Account[]
  roles      UserRole[] @relation("UserRoles")
  rolesGiven UserRole[] @relation("UserRolesGrantedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credentials per provider. For email/password `providerId = "credential"` and `password` holds an argon2id hash.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Request counters for rate limiting (shared by all API instances, no Redis required).
model RateLimit {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// RBAC: roles and permissions live in the database; permission codes are declared in code
// (src/rbac/permissions.ts) and synchronised by migrations.
// ---------------------------------------------------------------------------

model Role {
  code        String   @id
  name        String
  description String
  /// Lower number = more privileged. Used to stop staff granting roles at or above their own level.
  rank        Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleCode    String   @map("role_code")
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleCode], references: [code])
  grantedBy User? @relation("UserRolesGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleCode])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit log: append-only. UPDATE/DELETE/TRUNCATE are rejected by a database trigger.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// No FK: entries must survive user deletion/anonymisation.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  outcome    String
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  metadata   Json     @default("{}")

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// ---------- PHASE 4: core content ----------
// Statuses are plain strings guarded by CHECK constraints in the migration:
//   content status: draft | pending | published | rejected | archived

model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  module    String
  slug      String
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  news          NewsArticle[]
  announcements Announcement[]
  organizations Organization[]
  events        Event[]
  directory     DirectoryEntry[]

  @@unique([module, slug])
  @@map("categories")
}

model MediaAsset {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  mime       String
  size       Int
  alt        String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("media_assets")
}

model NewsArticle {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String
  coverId     String?   @map("cover_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  status      String    @default("draft")
  pinned      Boolean   @default(false)
  sourceName  String?   @map("source_name")
  sourceUrl   String?   @map("source_url")
  isDemo      Boolean   @default(false) @map("is_demo")
  authorId    String?   @map("author_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Announcement {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  title          String
  description    String
  categoryId     String    @map("category_id") @db.Uuid
  price          Int?
  condition      String?
  area           String?
  contactPhone   String?   @map("contact_phone")
  imageIds       String[]  @default([]) @map("image_ids") @db.Uuid
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  isDemo         Boolean   @default(false) @map("is_demo")
  authorId       String    @map("author_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

model Organization {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  kind           String    @default("organization")
  name           String
  description    String
  services       String    @default("")
  categoryId     String?   @map("category_id") @db.Uuid
  phone          String?
  website        String?
  address        String?
  serviceArea    String?   @map("service_area")
  hours          String?
  hoursCheckedAt DateTime? @map("hours_checked_at") @db.Timestamptz(6)
  verification   String    @default("unverified")
  sourceName     String?   @map("source_name")
  sourceUrl      String?   @map("source_url")
  checkedAt      DateTime? @map("checked_at") @db.Timestamptz(6)
  status         String    @default("draft")
  isDemo         Boolean   @default(false) @map("is_demo")
  ownerId        String?   @map("owner_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, kind])
  @@map("organizations")
}

model Event {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug            String    @unique
  title           String
  description     String
  organizer       String
  location        String
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  timezone        String    @default("Asia/Novosibirsk")
  registrationUrl String?   @map("registration_url")
  capacity        Int?
  categoryId      String?   @map("category_id") @db.Uuid
  status          String    @default("draft")
  isDemo          Boolean   @default(false) @map("is_demo")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      Category?           @relation(fields: [categoryId], references: [id])
  registrations EventRegistration[]

  @@index([status, startsAt])
  @@map("events")
}

model EventRegistration {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model DirectoryEntry {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug       String    @unique
  title      String
  kind       String    @default("contact")
  body       String    @default("")
  phone      String?
  url        String?
  categoryId String?   @map("category_id") @db.Uuid
  sourceName String?   @map("source_name")
  sourceUrl  String?   @map("source_url")
  checkedAt  DateTime? @map("checked_at") @db.Timestamptz(6)
  status     String    @default("draft")
  position   Int       @default(0)
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, position])
  @@map("directory_entries")
}
