generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level key/value configuration. Values are non-secret; secrets live only in the environment.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Authentication (managed by Better Auth; field names follow its schema)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// Public profile photo; a media asset uploaded by the user.
  avatarId      String?   @map("avatar_id") @db.Uuid
  /// Set by staff; a blocked user cannot sign in and all sessions are revoked.
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          Session[]
  accounts          Account[]
  roles             UserRole[]               @relation("UserRoles")
  rolesGiven        UserRole[]               @relation("UserRolesGrantedBy")
  posts             Post[]
  comments          Comment[]
  groupMemberships  GroupMember[]
  conversations     ConversationMember[]
  messages          Message[]
  blocksMade        UserBlock[]              @relation("BlocksMade")
  blocksReceived    UserBlock[]              @relation("BlocksReceived")
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  interests         UserInterest[]
  hiddenItems       HiddenItem[]
  residentProfile   ResidentProfile?
  reviews           OrganizationReview[]
  avatar            MediaAsset?              @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credentials per provider. For email/password `providerId = "credential"` and `password` holds an argon2id hash.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Request counters for rate limiting (shared by all API instances, no Redis required).
model RateLimit {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// RBAC: roles and permissions live in the database; permission codes are declared in code
// (src/rbac/permissions.ts) and synchronised by migrations.
// ---------------------------------------------------------------------------

model Role {
  code        String   @id
  name        String
  description String
  /// Lower number = more privileged. Used to stop staff granting roles at or above their own level.
  rank        Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  code        String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleCode    String   @map("role_code")
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleCode], references: [code])
  grantedBy User? @relation("UserRolesGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleCode])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit log: append-only. UPDATE/DELETE/TRUNCATE are rejected by a database trigger.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// No FK: entries must survive user deletion/anonymisation.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  outcome    String
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  metadata   Json     @default("{}")

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// ---------- PHASE 4: core content ----------
// Statuses are plain strings guarded by CHECK constraints in the migration:
//   content status: draft | pending | published | rejected | archived

model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  module    String
  slug      String
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  news          NewsArticle[]
  announcements Announcement[]
  organizations Organization[]
  events        Event[]
  directory     DirectoryEntry[]
  interests     UserInterest[]

  @@unique([module, slug])
  @@map("categories")
}

model MediaAsset {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  mime       String
  size       Int
  alt        String   @default("")
  /// Private assets (message attachments) are served only to the owner and conversation members.
  private    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  avatarOf User[] @relation("UserAvatar")

  @@index([ownerId])
  @@map("media_assets")
}

model NewsArticle {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  body        String
  coverId     String?   @map("cover_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  status      String    @default("draft")
  pinned      Boolean   @default(false)
  sourceName  String?   @map("source_name")
  sourceUrl   String?   @map("source_url")
  isDemo      Boolean   @default(false) @map("is_demo")
  authorId    String?   @map("author_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@map("news_articles")
}

model Announcement {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  title          String
  description    String
  categoryId     String    @map("category_id") @db.Uuid
  price          Int?
  condition      String?
  area           String?
  contactPhone   String?   @map("contact_phone")
  imageIds       String[]  @default([]) @map("image_ids") @db.Uuid
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  isDemo         Boolean   @default(false) @map("is_demo")
  authorId       String    @map("author_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

model Organization {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  kind           String    @default("organization")
  name           String
  description    String
  services       String    @default("")
  categoryId     String?   @map("category_id") @db.Uuid
  phone          String?
  website        String?
  address        String?
  serviceArea    String?   @map("service_area")
  latitude       Float?
  longitude      Float?
  hours          String?
  hoursCheckedAt DateTime? @map("hours_checked_at") @db.Timestamptz(6)
  verification   String    @default("unverified")
  sourceName     String?   @map("source_name")
  sourceUrl      String?   @map("source_url")
  checkedAt      DateTime? @map("checked_at") @db.Timestamptz(6)
  status         String    @default("draft")
  isDemo         Boolean   @default(false) @map("is_demo")
  ownerId        String?   @map("owner_id") @db.Uuid
  /// Owner-submitted edits of a published card, applied only after staff review.
  pendingChanges Json?     @map("pending_changes")
  reviewNote     String?   @map("review_note")
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category  Category?         @relation(fields: [categoryId], references: [id])
  inquiries BusinessInquiry[]
  reviews   OrganizationReview[]

  @@index([status, kind])
  @@index([ownerId])
  @@map("organizations")
}

model Event {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug            String    @unique
  title           String
  description     String
  organizer       String
  location        String
  latitude        Float?
  longitude       Float?
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  timezone        String    @default("Asia/Novosibirsk")
  registrationUrl String?   @map("registration_url")
  capacity        Int?
  categoryId      String?   @map("category_id") @db.Uuid
  status          String    @default("draft")
  isDemo          Boolean   @default(false) @map("is_demo")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category      Category?           @relation(fields: [categoryId], references: [id])
  registrations EventRegistration[]

  @@index([status, startsAt])
  @@map("events")
}

model EventRegistration {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model DirectoryEntry {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug       String    @unique
  title      String
  kind       String    @default("contact")
  body       String    @default("")
  phone      String?
  url        String?
  categoryId String?   @map("category_id") @db.Uuid
  sourceName String?   @map("source_name")
  sourceUrl  String?   @map("source_url")
  checkedAt  DateTime? @map("checked_at") @db.Timestamptz(6)
  status     String    @default("draft")
  position   Int       @default(0)
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, position])
  @@map("directory_entries")
}

/// Resident report about published content; reviewed by staff with `complaints.manage`.
model Complaint {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  reason         String
  details        String    @default("")
  status         String    @default("open")
  resolutionNote String?   @map("resolution_note")
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@index([reporterId])
  @@map("complaints")
}

/// Resident request to a business that has an owner account; visible to the sender and the owner only.
model BusinessInquiry {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  message        String
  contact        String?
  status         String    @default("new")
  reply          String?
  repliedAt      DateTime? @map("replied_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([senderId])
  @@map("business_inquiries")
}

model Job {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  title          String
  employer       String
  description    String
  conditions     String    @default("")
  requirements   String    @default("")
  salary         String?
  schedule       String?
  area           String?
  contactPhone   String?   @map("contact_phone")
  contactNote    String?   @map("contact_note")
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  authorId       String    @map("author_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("jobs")
}

model LostFoundItem {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String    @unique
  kind           String
  subject        String
  title          String
  description    String
  area           String?
  happenedOn     DateTime? @map("happened_on") @db.Date
  imageIds       String[]  @default([]) @map("image_ids") @db.Uuid
  contactPhone   String?   @map("contact_phone")
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  authorId       String    @map("author_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("lost_found")
}

/// Resident report about a problem in the territory. Handled by platform staff; no automatic hand-off to authorities.
model Issue {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number      Int      @unique @default(autoincrement())
  reporterId  String   @map("reporter_id") @db.Uuid
  category    String
  title       String
  description String
  address     String?
  imageIds    String[] @default([]) @map("image_ids") @db.Uuid
  isPublic    Boolean  @default(false) @map("is_public")
  contact     String?
  status      String   @default("received")
  priority    String   @default("normal")
  assigneeId  String?  @map("assignee_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updates IssueUpdate[]

  @@index([status, createdAt])
  @@index([reporterId])
  @@map("issues")
}

model IssueUpdate {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  issueId    String   @map("issue_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  kind       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  body       String   @default("")
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_updates")
}

/// Community poll. Not an official vote; one ballot per account is enforced by a unique index.
model Poll {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug        String   @unique
  title       String
  description String   @default("")
  mode        String   @default("anonymous")
  allowRevote Boolean  @default(false) @map("allow_revote")
  opensAt     DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt    DateTime @map("closes_at") @db.Timestamptz(6)
  status      String   @default("draft")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  options PollOption[]
  votes   PollVote[]

  @@index([status, opensAt])
  @@map("polls")
}

model PollOption {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  label    String
  position Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@map("poll_votes")
}

/// Resident groups (PHASE 7). New groups wait for a platform moderator (`moderation.community`).
model Group {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug           String   @unique
  name           String
  description    String   @default("")
  rules          String   @default("")
  topic          String
  visibility     String   @default("open")
  status         String   @default("pending")
  moderationNote String?  @map("moderation_note")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members GroupMember[]
  posts   Post[]

  @@index([status, createdAt])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// Feed post: general feed when `groupId` is null, otherwise inside a group.
model Post {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  groupId        String?   @map("group_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String
  link           String?
  imageIds       String[]  @default([]) @map("image_ids") @db.Uuid
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  pinned         Boolean   @default(false)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions PostReaction[]

  @@index([status, publishedAt])
  @@index([groupId, status, publishedAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  body           String
  status         String    @default("published")
  moderationNote String?   @map("moderation_note")
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("comments")
}

model PostReaction {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_reactions")
}

/// Bookmarks across modules; resolved against the live record, so hidden items show as unavailable.
model Favorite {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Conversation {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Sorted "userA:userB" — one direct conversation per pair of users.
  pairKey       String    @unique @map("pair_key")
  createdById   String    @map("created_by_id") @db.Uuid
  /// Null until the first message; empty conversations are not listed.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  members  ConversationMember[]
  messages Message[]

  @@index([createdById, createdAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  /// Client-generated key so a retried send does not create a duplicate.
  clientId       String?  @map("client_id")
  body           String   @default("")
  mediaIds       String[] @default([]) @map("media_ids") @db.Uuid
  status         String   @default("sent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Notification {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  href      String?
  category  String    @default("system")
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, category, createdAt])
  @@map("notifications")
}

/// Opt-outs for non-essential in-app notification categories; absence of a row means "enabled".
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  category  String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// Privacy-minimal analytics: no IP, no user agent, no raw user id (only a pseudonymous `actor`).
model AnalyticsEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  module       String?
  path         String?
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  actor        String?
  source       String?
  medium       String?
  campaign     String?
  referrerHost String?  @map("referrer_host")
  query        String?
  results      Int?
  meta         Json     @default("{}")

  @@index([occurredAt])
  @@index([name, occurredAt])
  @@map("analytics_events")
}

/// Categories a resident chose for recommendations; nothing is inferred behind their back.
model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("user_interests")
}

/// Items a resident hid from their recommendations.
model HiddenItem {
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entityType, entityId])
  @@map("hidden_items")
}

/// Territory hierarchy (region → district → locality). Only active localities are selectable; content is
/// not yet scoped by territory because there is a single one (see docs/TERRITORIES.md).
model Territory {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String   @unique
  name      String
  kind      String
  parentId  String?  @map("parent_id") @db.Uuid
  isActive  Boolean  @default(false) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   Territory?  @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Territory[] @relation("TerritoryTree")

  @@index([parentId])
  @@map("territories")
}

/// Opt-in public profile of a resident. No row or `isPublic = false` means the profile is hidden.
model ResidentProfile {
  userId    String   @id @map("user_id") @db.Uuid
  isPublic  Boolean  @default(false) @map("is_public")
  bio       String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resident_profiles")
}

/// Resident review of an organization. Premoderated: visible only after a moderator approves it.
model OrganizationReview {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  rating         Int
  body           String
  status         String    @default("pending")
  moderationNote String?   @map("moderation_note")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([organizationId, authorId])
  @@index([status, createdAt])
  @@map("organization_reviews")
}
